# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Python API (optional if running locally)
VITE_API_URL=http://localhost:5001

# Gorgias (required for the Python API server)
GORGIAS_AUTH=Basic your-base64-encoded-credentials
GORGIAS_DOMAIN=yourcompany.gorgias.com

# Anthropic (required for AI scoring)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase JWT secret — used by the Python API to verify caller identity
# Found in: Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase service-role key — server-side writes with no user context (Cortex
# grading persistence + external score ingestion). It bypasses row-level security,
# so keep it server-only: never give it a VITE_ prefix or expose it to the frontend.
# Found in: Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack Bot Token — enables sending score DMs to agents
# Create a Slack app with chat:write and users:read.email scopes, then paste the Bot Token here
# Never expose this to the frontend — server-side only
SLACK_BOT_TOKEN=xoxb-...

# ── Cortex / external grading (optional) ─────────────────────────────────────
# Two independent integration paths, each gated by its own shared secret. Leave a
# secret unset to disable that endpoint; both also need SUPABASE_SERVICE_ROLE_KEY above.
#
# POST /api/grade-ticket  (header: X-Cortex-Secret) — recommended. Cortex sends a
# ticket_id and the SERVER fetches + grades it with Claude, so the rubric stays
# server-side. Also needs GORGIAS_AUTH + ANTHROPIC_API_KEY.
CORTEX_INGEST_SECRET=generate-a-long-random-value
#
# POST /api/ingest-score  (header: X-Ingest-Secret) — an external system grades the
# ticket itself and POSTs the finished result. Generate a long random value, e.g.
#   openssl rand -hex 32
INGEST_WEBHOOK_SECRET=
