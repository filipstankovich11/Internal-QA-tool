# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Python API (optional if running locally)
VITE_API_URL=http://localhost:5001

# Gorgias (required for the Python API server)
GORGIAS_AUTH=Basic your-base64-encoded-credentials
GORGIAS_DOMAIN=yourcompany.gorgias.com

# Anthropic (required for AI scoring)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase JWT secret — used by the Python API to verify caller identity
# Found in: Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Slack Bot Token — enables sending score DMs to agents
# Create a Slack app with chat:write and users:read.email scopes, then paste the Bot Token here
# Never expose this to the frontend — server-side only
SLACK_BOT_TOKEN=xoxb-...

# ── External score ingestion (POST /api/ingest-score) ────────────────────────
# Lets a trusted external system (e.g. a Cortex automation) push QA results in.
# Both are required for that endpoint; leave INGEST_WEBHOOK_SECRET unset to disable it.
#
# Shared secret the external caller sends as `X-Ingest-Secret` (or Bearer token).
# Generate a long random value, e.g.  openssl rand -hex 32
INGEST_WEBHOOK_SECRET=
# Supabase service-role key — used ONLY to write ingested scores (no user context).
# Found in: Supabase dashboard → Project Settings → API → service_role key.
# Never expose this to the frontend — server-side only; it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
